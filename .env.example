# Copy this file to .env and fill in your Supabase project's values.
# docker compose reads .env automatically. These are not used in v1
# (progress is stored in localStorage), but the client in
# lib/supabaseClient.ts is wired up to read them for v2.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Lookup mode (Mapbox). Two separate tokens on purpose:
#  - MAPBOX_ACCESS_TOKEN is server-only (Tier 2 Search Box fallback in
#    app/api/geo/mapbox). Never exposed to the browser; keep it secret.
#  - NEXT_PUBLIC_MAPBOX_TOKEN is inlined into the client bundle to render the
#    map. Restrict it by URL in the Mapbox account. Without it the map shows a
#    graceful placeholder.
MAPBOX_ACCESS_TOKEN=
NEXT_PUBLIC_MAPBOX_TOKEN=
